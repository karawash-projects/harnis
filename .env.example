# Copy to .env (python tasks.py env). Everything here has a working local default.
ENV=development

# Host ports for the containers. `python tasks.py up` changes these (and the
# URLs below) automatically if another program already uses a port.
POSTGRES_PORT=5432
REDIS_PORT=6379
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
KEYCLOAK_PORT=8080          # local Keycloak for `python tasks.py sso-up` (testing only)

# Postgres: the app connects as harnis_app (non-owner, non-superuser => RLS applies).
DATABASE_URL=postgresql://harnis_app:harnis_app@127.0.0.1:5432/harnis
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/harnis
APP_DB_PASSWORD=harnis_app

REDIS_URL=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# local: tokens signed with JWT_SECRET (development, or an internal gateway).
# oidc:  tokens from your identity provider (Okta, Entra ID, Auth0, Keycloak, Google).
# Service API keys (hrn_...) work in both modes; tenant admins create them.
AUTH_MODE=local
# OIDC_ISSUER=https://login.example.com/
# OIDC_AUDIENCE=harnis-api
# OIDC_USER_CLAIM=sub                     # or email / preferred_username
# OIDC_TENANT_CLAIM=tenant_id             # dotted paths work: org.id
# OIDC_DEFAULT_TENANT=                    # single-tenant deployments
# OIDC_ROLES_CLAIM=roles                  # groups (Okta, Entra ID), realm_access.roles (Keycloak)
# OIDC_ROLE_MAP={"harnis-reviewers": "reviewer", "harnis-admins": "admin", "platform-ops": "platform-admin"}
# OIDC_DEFAULT_ROLE=user
# Web console sign-in: a public SPA client in your IdP, redirect URI https://<host>/
# OIDC_CONSOLE_CLIENT_ID=
# OIDC_CONSOLE_SCOPES=openid profile email
# OIDC_CONSOLE_EXTRA_PARAMS={"audience": "harnis-api"}
# OIDC_CONSOLE_TOKEN=access_token         # or id_token
# CONSOLE_ENABLED=true                    # false: serve only the API

# Signing key for AUTH_MODE=local. Production: a long random secret (or use AUTH_MODE=oidc).
JWT_SECRET=dev-only-change-me-dev-only-change-me
# Lets one developer request AND approve (the CLI's solo workflow). Never in production.
ALLOW_SELF_APPROVAL=true

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# Failover order. A provider without credentials is skipped (the API logs the
# final chain at startup); "mock" needs nothing and is refused in production.
LLM_PROVIDERS=anthropic,openai,gemini,nova,openai_compatible,mock

# Plugins: comma-separated entry-point names or module paths (see docs/plugins.md).
PLUGINS=

# "main" models do the work; "fast" models do routing.
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_FAST_MODEL=gpt-5.4-mini

# Self-hosted / proxied models with an OpenAI-compatible API (vLLM, Ollama, LM Studio, LiteLLM).
OPENAI_COMPATIBLE_BASE_URL=               # e.g. http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_FAST_MODEL=

# Google Gemini: API key from Google AI Studio (GOOGLE_API_KEY also works).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Or use Vertex AI with your Google Cloud credentials instead of an API key:
# GEMINI_USE_VERTEXAI=true
# GEMINI_VERTEX_PROJECT=my-gcp-project
# GEMINI_VERTEX_LOCATION=us-central1

# Amazon Nova on Bedrock. Enabled when AWS_REGION is set and AWS credentials are
# found in the usual places: AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY below,
# AWS_PROFILE (incl. `aws sso login`), or an IAM role when running on AWS.
# The account needs Bedrock model access for these models in that region.
# Model ids are cross-region inference profiles: us./eu./jp./global. to match your region.
AWS_REGION=
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # only for temporary credentials
NOVA_MODEL=us.amazon.nova-2-lite-v1:0
NOVA_FAST_MODEL=us.amazon.nova-micro-v1:0
NOVA_TEMPERATURE=0          # greedy decoding, as AWS recommends for tool calling

# Model prices, USD per million tokens, [input, output]. Cost figures and cost
# budgets depend on them. `python tasks.py pricing` asks for the models you have
# configured and fills this in. ENV=production refuses to start without them.
# PRICING_OVERRIDES={"claude-sonnet-5-5": [3.0, 15.0], "claude-haiku-5-5": [1.0, 5.0]}
# PRICING_FILE=pricing.json   # alternative: a JSON file with the same shape

MAX_COST_USD_PER_TURN=2.00
MAX_STEPS_PER_TURN=25
# If the coder ends a turn by announcing a step ("Now let me write the tests.") without
# calling a tool, the harness tells it to continue, at most this many times per turn.
AUTO_CONTINUE_MAX=2

SANDBOX_IMAGE=harnis-sandbox:latest
# docker (default) or kubernetes: one Pod per command (see docs/kubernetes.md; the Helm chart sets this)
SANDBOX_BACKEND=docker
# copy = stream the workspace through the Docker API (Windows, macOS, Linux, remote daemons)
# bind = bind-mount it (Linux only, faster for large workspaces)
SANDBOX_WORKSPACE_MODE=copy
# SANDBOX_RUNTIME=runsc      # gVisor (Linux hosts), strongly recommended for untrusted code
# Dependency installs (the approved install_dependencies tool): the only sandbox
# runs with network, and only through an allowlisting HTTPS proxy.
# SANDBOX_INSTALL_ENABLED=true
# SANDBOX_EGRESS_ALLOW=pypi.org,files.pythonhosted.org,registry.npmjs.org
# SANDBOX_EGRESS_UPSTREAM_PROXY=http://proxy.corp:3128   # corporate proxy
# SANDBOX_EGRESS_ALLOW_PRIVATE=false                      # true for an internal mirror
WORKSPACES_DIR=.workspaces

# Data retention in days, applied by `python tasks.py maintenance` (0 = keep forever).
RETENTION_SESSION_DAYS=0
RETENTION_AUDIT_DAYS=0

# Prometheus metrics at /metrics. In production they are only served with a token.
METRICS_ENABLED=true
# METRICS_TOKEN=
# Docker connection: leave unset to use the default (named pipe on Windows,
# /var/run/docker.sock elsewhere). Set for remote daemons, e.g. tcp://host:2376
# DOCKER_HOST=

# Alerts (optional)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KIND=slack

# Tracing to Jaeger (UI: http://localhost:16686). Production: point this at your
# OpenTelemetry collector; https:// endpoints use TLS.
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# OTEL_EXPORTER_OTLP_INSECURE=false
