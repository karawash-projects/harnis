{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harnis Helm chart values",
  "type": "object",
  "definitions": {
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "quantity": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei)?$"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "peers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    },
    "cron": {
      "type": "string",
      "minLength": 9
    }
  },
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "$ref": "#/definitions/image"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "containerPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "resources": {
          "type": "object"
        },
        "preStopSleepSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "readinessProbe": {
          "type": "object"
        },
        "livenessProbe": {
          "type": "object"
        },
        "startupProbe": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "tmpSizeLimit": {
          "$ref": "#/definitions/quantity"
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podLabels": {
          "$ref": "#/definitions/stringMap"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "extraEnvFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "config": {
      "type": "object",
      "description": "Non-secret settings by environment variable name.",
      "propertyNames": {
        "pattern": "^[A-Z_][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "existingMigrationSecret": {
          "type": "string"
        },
        "jwtSecret": {
          "type": "string",
          "anyOf": [
            {
              "maxLength": 0
            },
            {
              "minLength": 32
            }
          ],
          "description": "Empty (generated) or at least 32 characters."
        },
        "anthropicApiKey": {
          "type": "string"
        },
        "openaiApiKey": {
          "type": "string"
        },
        "geminiApiKey": {
          "type": "string"
        },
        "awsAccessKeyId": {
          "type": "string"
        },
        "awsSecretAccessKey": {
          "type": "string"
        },
        "alertWebhookUrl": {
          "type": "string"
        },
        "extra": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "sslmode": {
          "type": "string",
          "enum": [
            "disable",
            "allow",
            "prefer",
            "require",
            "verify-ca",
            "verify-full"
          ]
        },
        "appPassword": {
          "type": "string"
        },
        "ownerUser": {
          "type": "string"
        },
        "ownerPassword": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^(|postgres(ql)?://.+)$"
        },
        "migrationUrl": {
          "type": "string",
          "pattern": "^(|postgres(ql)?://.+)$"
        }
      }
    },
    "externalRedis": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "db": {
          "type": "integer",
          "minimum": 0
        },
        "password": {
          "type": "string"
        },
        "tls": {
          "type": "boolean"
        },
        "url": {
          "type": "string",
          "pattern": "^(|rediss?://.+)$"
        }
      }
    },
    "workspaces": {
      "type": "object",
      "properties": {
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        },
        "emptyDirSizeLimit": {
          "$ref": "#/definitions/quantity"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingClaim": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ReadWriteOnce",
                  "ReadOnlyMany",
                  "ReadWriteMany",
                  "ReadWriteOncePod"
                ]
              }
            },
            "size": {
              "$ref": "#/definitions/quantity"
            },
            "annotations": {
              "$ref": "#/definitions/stringMap"
            }
          }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "namespace": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^(|[a-z0-9]([-a-z0-9]*[a-z0-9])?)$",
              "maxLength": 63
            },
            "create": {
              "type": "boolean"
            },
            "labels": {
              "$ref": "#/definitions/stringMap"
            },
            "annotations": {
              "$ref": "#/definitions/stringMap"
            }
          }
        },
        "runtimeClassName": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "required": [
            "cpu",
            "memory",
            "ephemeralStorage"
          ],
          "properties": {
            "cpu": {
              "$ref": "#/definitions/quantity"
            },
            "memory": {
              "$ref": "#/definitions/quantity"
            },
            "ephemeralStorage": {
              "$ref": "#/definitions/quantity"
            }
          }
        },
        "workspaceSizeLimit": {
          "$ref": "#/definitions/quantity"
        },
        "tmpSizeLimit": {
          "$ref": "#/definitions/quantity"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "outputLimitBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxWorkspaceBytes": {
          "type": "integer",
          "minimum": 1
        },
        "podStartTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "networkProbe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "targets": {
              "type": "string",
              "pattern": "^(auto|off|[\\[\\]\\w.:-]+:[0-9]{1,5})(\\s*,\\s*(auto|[\\[\\]\\w.:-]+:[0-9]{1,5}))*$"
            },
            "timeoutSeconds": {
              "type": "number",
              "minimum": 1
            }
          }
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "podLabels": {
          "$ref": "#/definitions/stringMap"
        },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "denyAllInNamespace": {
              "type": "boolean"
            }
          }
        },
        "resourceQuota": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "hard": {
              "type": "object"
            }
          }
        },
        "reaper": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "schedule": {
              "$ref": "#/definitions/cron"
            },
            "olderThanSeconds": {
              "type": "integer",
              "minimum": 60
            }
          }
        },
        "install": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "maxDepsBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxDepsFiles": {
              "type": "integer",
              "minimum": 1
            },
            "egress": {
              "type": "object",
              "properties": {
                "allow": {
                  "type": "string",
                  "minLength": 1
                },
                "upstreamProxy": {
                  "type": "string",
                  "pattern": "^(|https?://.+)$"
                },
                "allowPrivate": {
                  "type": "boolean"
                },
                "to": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "ports": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            },
            "proxy": {
              "type": "object",
              "properties": {
                "replicas": {
                  "type": "integer",
                  "minimum": 1
                },
                "resources": {
                  "type": "object"
                }
              }
            },
            "dns": {
              "type": "object"
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "paths"
            ],
            "properties": {
              "host": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^/"
                    },
                    "pathType": {
                      "type": "string",
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": {
                "type": "string"
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "behavior": {
          "type": "object"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "apiNetworkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "$ref": "#/definitions/peers"
        },
        "dns": {
          "type": "object",
          "properties": {
            "namespaceSelector": {
              "type": "object"
            },
            "podSelector": {
              "type": "object"
            }
          }
        },
        "postgres": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer"
            },
            "to": {
              "$ref": "#/definitions/peers"
            }
          }
        },
        "redis": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer"
            },
            "to": {
              "$ref": "#/definitions/peers"
            }
          }
        },
        "kubeApiServer": {
          "type": "object",
          "properties": {
            "ports": {
              "$ref": "#/definitions/ports"
            },
            "to": {
              "$ref": "#/definitions/peers"
            }
          }
        },
        "https": {
          "type": "object",
          "properties": {
            "to": {
              "$ref": "#/definitions/peers"
            }
          }
        },
        "otlp": {
          "type": "object",
          "properties": {
            "ports": {
              "$ref": "#/definitions/ports"
            },
            "to": {
              "$ref": "#/definitions/peers"
            }
          }
        },
        "extraEgress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "migrations": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "maintenance": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "$ref": "#/definitions/cron"
        },
        "timeZone": {
          "type": "string"
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "jobs": {
      "type": "object",
      "properties": {
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "token": {
          "type": "string"
        },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "labels": {
              "$ref": "#/definitions/stringMap"
            }
          }
        }
      }
    }
  }
}
